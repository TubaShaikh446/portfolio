<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shaikh Tuba — ASP.NET Core MVC Developer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
    <style>
        /* ============================================================
                   TOKENS
                   ============================================================ */
        :root {
            --cream: #F4EEE3;
            --cream-2: #EFE7D8;
            --card: #FFFFFF;
            --navy: #171B33;
            --navy-soft: #171B3399;
            --text-muted: #6B7085;
            --border: #E7DFCE;
            --orange: #F1642A;
            --orange-dark: #C24A19;
            --orange-soft: #F1642A17;
            --tan: #C9976B;
            --tan-dark: #A97A50;
            --tag-purple-bg: #EDE7FC;
            --tag-purple-txt: #6D3FE0;
            --tag-tan-bg: #FCEBD6;
            --tag-tan-txt: #C2620F;
            --tag-teal-bg: #DEF5EC;
            --tag-teal-txt: #0E8F6E;
            --tag-indigo-bg: #E4E6FB;
            --tag-indigo-txt: #4A3FD1;
            --font: 'Plus Jakarta Sans', sans-serif;
            --radius-lg: 26px;
            --radius-md: 16px;
            --radius-sm: 10px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--cream);
            color: var(--navy);
            font-family: var(--font);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        .container {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 32px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            max-width: 100%;
            display: block;
        }

        :focus-visible {
            outline: 2px solid var(--orange);
            outline-offset: 3px;
        }
        @@media (prefers-reduced-motion: reduce) {
            *

        {
            animation: none !important;
            transition: none !important;
        }

        }

        h1, h2, h3, h4 {
            font-family: var(--font);
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--navy);
        }

        /* eyebrow: dash + orange label, matches reference */
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-weight: 700;
            font-size: 1.02rem;
            color: var(--orange);
            margin-bottom: 18px;
        }

            .eyebrow::before {
                content: "";
                width: 34px;
                height: 2px;
                background: var(--orange);
                display: block;
            }

        /* ============================================================
                   GRID HELPERS
                   ============================================================ */
        .row {
            display: flex;
            flex-wrap: wrap;
            margin: 0 -16px;
        }

            .row > [class*="col-"] {
                padding: 0 16px;
            }

        .col-lg-6 {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .col-lg-5 {
            flex: 0 0 41.6%;
            max-width: 41.6%;
        }

        .col-lg-7 {
            flex: 0 0 58.3%;
            max-width: 58.3%;
        }

        .col-lg-4 {
            flex: 0 0 33.33%;
            max-width: 33.33%;
        }

        .col-lg-3 {
            flex: 0 0 25%;
            max-width: 25%;
        }

        .col-md-6 {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .col-md-3 {
            flex: 0 0 25%;
            max-width: 25%;
        }

        .align-items-center {
            align-items: center;
        }

        .text-center {
            text-align: center;
        }

        .mt-4 {
            margin-top: 1.75rem;
        }

        .g-4 > [class*="col-"] {
            margin-bottom: 28px;
        }

        section {
            padding: 110px 0;
        }

        .section-title h2 {
            font-size: 2.6rem;
            line-height: 1.12;
            max-width: 640px;
        }

        .section-title p {
            color: var(--text-muted);
            max-width: 560px;
            margin-top: 16px;
            font-size: 1.05rem;
            font-weight: 500;
        }

        .text-center .section-title {
            margin: 0 auto;
            text-align: center;
        }

            .text-center .section-title h2, .text-center .section-title p {
                margin-left: auto;
                margin-right: auto;
            }

        .section-title.text-center h2,
        .section-title.text-center p {
            margin-left: auto;
            margin-right: auto;
        }

        /* ============================================================
                   NAVBAR — simple + friendly
                   ============================================================ */
        .navbar-premium {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: #F4EEE3CC;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
        }

        .nav-inner {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 84px;
        }

        .nav-brand {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--navy);
        }

            .nav-brand span {
                color: var(--orange);
            }

        .nav-links {
            display: flex;
            gap: 40px;
            list-style: none;
        }

            .nav-links a {
                font-weight: 600;
                font-size: 0.98rem;
                color: var(--navy);
                position: relative;
            }

                .nav-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: -6px;
                    height: 2px;
                    width: 0;
                    background: var(--orange);
                    transition: width .25s ease;
                }

                .nav-links a:hover::after {
                    width: 100%;
                }

        .nav-cta {
            font-weight: 700;
            font-size: 0.95rem;
            color: #fff;
            background: var(--navy);
            padding: 12px 24px;
            border-radius: 999px;
            transition: background .2s ease, transform .2s ease;
        }

            .nav-cta:hover {
                background: var(--orange);
                transform: translateY(-1px);
            }

        /* ============================================================
                   BUTTONS
                   ============================================================ */
        .btn {
            font-family: var(--font);
            font-weight: 700;
            font-size: 0.95rem;
            padding: 14px 28px;
            border-radius: 999px;
            border: 2px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
        }

        .btn-primary {
            background: var(--orange);
            color: #fff;
            box-shadow: 0 10px 24px -10px #f1642a99;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                background: var(--orange-dark);
            }

        .btn-outline-primary {
            background: transparent;
            border-color: var(--navy);
            color: var(--navy);
        }

            .btn-outline-primary:hover {
                background: var(--navy);
                color: #fff;
            }

        .btn-lg {
            padding: 15px 30px;
        }

        .btn-sm {
            padding: 11px 20px;
            font-size: 0.88rem;
        }

        /* ============================================================
                   HERO
                   ============================================================ */
        .hero {
            padding: 180px 0 110px;
        }

        .badge-custom {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            font-size: 0.92rem;
            color: var(--tan-dark);
            background: #fff;
            border: 1px solid var(--border);
            padding: 8px 18px;
            border-radius: 999px;
            margin-bottom: 26px;
            box-shadow: 0 6px 16px -10px #00000022;
        }

        .hero h1 {
            font-size: 3.6rem;
            line-height: 1.08;
            margin-bottom: 18px;
        }

            .hero h1 span {
                color: var(--orange);
            }

        .hero h3 {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 22px;
            min-height: 1.6em;
        }

        #typing::after {
            content: "";
            border-right: 2px solid var(--orange);
            margin-left: 2px;
            animation: blink 1s step-end infinite;
        }
        @@keyframes blink {
            50%

        {
            border-color: transparent;
        }

        }

        .hero p {
            color: var(--text-muted);
            font-size: 1.08rem;
            max-width: 480px;
            margin-bottom: 34px;
            font-weight: 500;
        }

        .hero-buttons {
            display: flex;
            gap: 14px;
            margin-bottom: 36px;
        }

        .social-icons {
            display: flex;
            gap: 14px;
        }

            .social-icons i {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: #fff;
                border: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                color: var(--navy);
                transition: all .2s ease;
                cursor: pointer;
                box-shadow: 0 8px 18px -12px #00000030;
            }

                .social-icons i:hover {
                    background: var(--orange);
                    color: #fff;
                    transform: translateY(-3px);
                }

        .profile-card {
            background: linear-gradient(160deg,#FFF7EA,#F7DFC4 60%,#F1C9A0);
            border-radius: 32px;
            padding: 18px;
            max-width: 400px;
            margin: 0 auto;
            box-shadow: 0 30px 60px -30px #00000040;
        }

        .profile-image, .about-image {
            width: 100%;
            aspect-ratio: 1/1;
            border-radius: 22px;
            background: linear-gradient(150deg,#FFE9CE,#FBD3A8 60%,#F3B27C);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 4.6rem;
            color: #ffffffcc;
            overflow: hidden;
        }

            .profile-image img, .about-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: inherit;
            }

        .about-image {
            aspect-ratio: auto;
            height: 100%;
            min-height: 360px;
            font-size: 3.6rem;
        }

        /* ============================================================
                   ABOUT
                   ============================================================ */
        .about-section {
            background: var(--cream-2);
        }

        .about-image-card {
            background: #fff;
            border-radius: var(--radius-lg);
            padding: 16px;
            height: 100%;
            box-shadow: 0 20px 44px -28px #00000030;
        }

        .section-tag {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-weight: 700;
            color: var(--orange);
            margin-bottom: 16px;
        }

            .section-tag::before {
                content: "";
                width: 34px;
                height: 2px;
                background: var(--orange);
                display: block;
            }

        .about-section h2 {
            font-size: 2.3rem;
            margin: 0 0 18px;
            max-width: 520px;
        }

        .about-section > .container > .row > .col-lg-7 > p {
            color: var(--text-muted);
            max-width: 520px;
            font-weight: 500;
        }

        .feature {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.98rem;
            font-weight: 600;
            padding: 9px 0;
        }

            .feature i {
                color: var(--orange);
                font-size: 1.15rem;
            }

        /* ============================================================
                   STATS
                   ============================================================ */
        .stats-section {
            padding: 80px 0;
        }

        .stat-card {
            background: #fff;
            border-radius: var(--radius-md);
            padding: 32px 20px;
            height: 100%;
            box-shadow: 0 16px 34px -24px #00000030;
            text-align: center;
        }

            .stat-card h2 {
                font-size: 2.5rem;
                color: var(--orange);
                margin-bottom: 6px;
            }

            .stat-card p {
                color: var(--text-muted);
                font-weight: 600;
                font-size: 0.92rem;
            }

        /* ============================================================
                   SKILLS
                   ============================================================ */
        .skill-card {
            background: #fff;
            border-radius: var(--radius-md);
            padding: 30px 26px;
            height: 100%;
            box-shadow: 0 16px 34px -26px #00000030;
            transition: transform .25s ease;
            text-align: center;
        }

            .skill-card:hover {
                transform: translateY(-6px);
            }

        .skill-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: var(--orange-soft);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: var(--orange);
            margin: 0 auto 18px;
        }

        .skill-card h4 {
            font-size: 1.15rem;
            margin-bottom: 6px;
        }

        .skill-card .skill-sub {
            color: var(--text-muted);
            font-size: 0.86rem;
            font-weight: 500;
            margin-bottom: 20px;
        }

        .skill-tags {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
        }

        .skill-tag {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--navy);
            background: var(--cream-2);
            border: 1px solid var(--border);
            padding: 7px 14px;
            border-radius: 999px;
            transition: background .2s ease, border-color .2s ease, color .2s ease;
        }

            .skill-tag:hover {
                background: var(--orange);
                border-color: var(--orange);
                color: #fff;
            }

        /* ============================================================
                   PROJECTS — horizontal scroll cards (reference layout)
                   ============================================================ */
        .projects-section {
            overflow: hidden;
        }

        .projects-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 50px;
            flex-wrap: wrap;
            gap: 24px;
        }

            .projects-header .section-title {
                margin-bottom: 0;
            }

        .scroll-controls {
            display: flex;
            gap: 12px;
        }

        .scroll-btn {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: var(--orange);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            border: none;
            cursor: pointer;
            transition: transform .2s ease, background .2s ease;
        }

            .scroll-btn:hover {
                background: var(--orange-dark);
                transform: translateY(-2px);
            }

            .scroll-btn.disabled {
                opacity: 0.35;
                cursor: default;
                pointer-events: none;
            }

        .project-track-wrap {
            position: relative;
            margin: 0 -32px;
            padding: 0 32px;
        }

        .project-track {
            display: flex;
            gap: 26px;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            padding: 10px 0 20px;
            scrollbar-width: none;
        }

            .project-track::-webkit-scrollbar {
                display: none;
            }

        .project-card {
            scroll-snap-align: start;
            flex: 0 0 340px;
            background: #fff;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: 0 24px 50px -28px #00000038;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .project-img {
            height: 210px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.6rem;
            color: #ffffffe0;
            text-align: center;
        }

            .project-img.bg-1 {
                background: linear-gradient(150deg,#FFE1A8,#F5B95A);
            }

            .project-img.bg-2 {
                background: linear-gradient(150deg,#C9E4FF,#7FB6EE);
            }

            .project-img.bg-3 {
                background: linear-gradient(150deg,#FBD9C6,#F0916A);
            }

        .ribbon {
            position: absolute;
            top: 18px;
            left: -46px;
            width: 170px;
            text-align: center;
            background: var(--orange);
            color: #fff;
            font-size: 0.72rem;
            font-weight: 800;
            padding: 6px 0;
            transform: rotate(-45deg);
            box-shadow: 0 6px 14px -6px #00000040;
        }

        .project-content {
            padding: 26px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            flex: 1;
        }

            .project-content h4 {
                font-size: 1.28rem;
            }

        .project-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .tag {
            font-size: 0.76rem;
            font-weight: 700;
            padding: 5px 13px;
            border-radius: 999px;
        }

            .tag.purple {
                background: var(--tag-purple-bg);
                color: var(--tag-purple-txt);
            }

            .tag.tan {
                background: var(--tag-tan-bg);
                color: var(--tag-tan-txt);
            }

            .tag.teal {
                background: var(--tag-teal-bg);
                color: var(--tag-teal-txt);
            }

            .tag.indigo {
                background: var(--tag-indigo-bg);
                color: var(--tag-indigo-txt);
            }

            .tag.outline {
                background: #fff;
                color: var(--navy-soft);
                border: 1px solid var(--border);
            }

        .project-content p.desc {
            color: var(--text-muted);
            font-size: 0.94rem;
            font-weight: 500;
            flex: 1;
        }

        .project-buttons {
            display: flex;
            gap: 10px;
            margin-top: 6px;
        }

        .icon-btn {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: var(--cream-2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            color: var(--navy);
            flex-shrink: 0;
        }

        .project-buttons .btn {
            flex: 1;
            justify-content: center;
            border-radius: 12px;
            padding: 13px 20px;
        }

        .btn-tan {
            background: var(--tan);
            color: #fff;
        }

            .btn-tan:hover {
                background: var(--tan-dark);
            }

        /* ============================================================
                   TIMELINE — clean, simple
                   ============================================================ */
        .timeline-section {
            background: var(--cream-2);
        }

        .timeline {
            position: relative;
            max-width: 880px;
            margin: 0 auto;
        }

            .timeline::before {
                content: "";
                position: absolute;
                left: 50%;
                top: 6px;
                bottom: 6px;
                width: 2px;
                background: var(--border);
                transform: translateX(-50%);
            }

        .timeline-item {
            position: relative;
            width: 50%;
            padding: 0 44px 56px;
        }

            .timeline-item.left {
                left: 0;
                text-align: right;
            }

            .timeline-item.right {
                left: 50%;
                text-align: left;
            }

            .timeline-item::after {
                content: "";
                position: absolute;
                top: 8px;
                width: 14px;
                height: 14px;
                border-radius: 50%;
                background: var(--orange);
                border: 3px solid var(--cream-2);
                box-shadow: 0 0 0 2px var(--orange);
                z-index: 2;
            }

            .timeline-item.left::after {
                right: -8px;
            }

            .timeline-item.right::after {
                left: -8px;
            }

        .timeline-content {
            background: #fff;
            border-radius: var(--radius-md);
            padding: 26px 28px;
            box-shadow: 0 16px 34px -26px #00000030;
            display: inline-block;
            text-align: left;
            width: 100%;
        }

        .year {
            display: inline-block;
            font-weight: 800;
            font-size: 0.8rem;
            color: #fff;
            background: var(--orange);
            padding: 4px 13px;
            border-radius: 999px;
            margin-bottom: 12px;
        }

        .timeline-content h4 {
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .timeline-content p {
            color: var(--text-muted);
            font-size: 0.94rem;
            font-weight: 500;
        }

        /* ============================================================
                   FOOTER / CONTACT
                   ============================================================ */
        .contact-section {
            text-align: center;
        }

            .contact-section h2 {
                font-size: 2.6rem;
                margin-bottom: 18px;
            }

            .contact-section p {
                color: var(--text-muted);
                font-weight: 500;
                max-width: 480px;
                margin: 0 auto 34px;
            }

        footer {
            padding: 36px 0;
            text-align: center;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.9rem;
            border-top: 1px solid var(--border);
        }

            footer span {
                color: var(--orange);
            }

        /* ============================================================
                   RESPONSIVE
                   ============================================================ */
        @@media (max-width: 991px) {
            .col-lg-6,.col-lg-5,.col-lg-7,.col-lg-4,.col-lg-3

        {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .col-lg-6 + .col-lg-6 {
            margin-top: 40px;
        }

        .col-lg-5 {
            margin-bottom: 32px;
        }

        .nav-links {
            display: none;
        }

        .hero {
            text-align: center;
            padding-top: 150px;
        }

            .hero p {
                margin-left: auto;
                margin-right: auto;
            }

        .hero-buttons, .social-icons {
            justify-content: center;
        }

        .timeline::before {
            left: 20px;
        }

        .timeline-item, .timeline-item.left, .timeline-item.right {
            width: 100%;
            left: 0;
            text-align: left;
            padding-left: 52px;
            padding-right: 0;
        }

            .timeline-item.left::after, .timeline-item.right::after {
                left: 14px;
            }

        }
        @@media (max-width: 767px) {
            .col-md-6,.col-md-3

        {
            flex: 0 0 100%;
            max-width: 100%;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 2.5rem;
        }

        section {
            padding: 80px 0;
        }

        .project-card {
            flex-basis: 290px;
        }

        }
    </style>
</head>
<body>

    <!-- ============================================================
         NAVBAR
         ============================================================ -->
    <nav class="navbar-premium">
        <div class="nav-inner">
            <a href="#" class="nav-brand">Shaikh <span>Tuba</span></a>
