    <script>
        // typing effect
        const words = ["ASP.NET Core MVC Developer", "C# Backend Developer", "SQL Server & EF Core", "Power BI Analyst"];
        const el = document.getElementById('typing');
        let wi = 0, ci = 0, deleting = false;
        function tick(){
          const word = words[wi];
          el.textContent = deleting ? word.slice(0, ci--) : word.slice(0, ci++);
          if(!deleting && ci === word.length + 1){ deleting = true; setTimeout(tick, 1400); return; }
          if(deleting && ci === -1){ deleting = false; wi = (wi+1) % words.length; ci = 0; }
          setTimeout(tick, deleting ? 35 : 65);
        }
        tick();

        // project scroll controls
        const track = document.getElementById('projectTrack');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const scrollAmount = 366;
        prevBtn.addEventListener('click', () => track.scrollBy({ left: -scrollAmount, behavior: 'smooth' }));
        nextBtn.addEventListener('click', () => track.scrollBy({ left: scrollAmount, behavior: 'smooth' }));
    </script>
